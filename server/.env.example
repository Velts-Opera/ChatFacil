# Railway injeta PORT automaticamente. O servidor sempre escuta em 0.0.0.0.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=INSIRA_A_ANON_KEY_AQUI
SUPABASE_SERVICE_ROLE_KEY=INSIRA_A_SERVICE_ROLE_KEY_AQUI
# Provedor OpenAI-compatible (OpenAI, Alibaba DashScope, etc.)
AI_PROVIDER=alibaba
AI_API_KEY=INSIRA_A_CHAVE_DA_IA_AQUI
AI_BASE_URL=https://SEU_ENDPOINT_COMPATIVEL/compatible-mode/v1
AI_MODEL=qwen-plus
# Alternativa: use GEMINI_API_KEY e GEMINI_MODEL sem as variáveis AI_* acima.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ALLOWED_ORIGINS=https://SEU_FRONTEND.vercel.app
SESSION_DATA_PATH=/data
